APP_NAME="KYAF খাদ্য দান ব্যবস্থাপনা"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_LOCALE=bn

LOG_CHANNEL=single
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=kyaf_food_donation
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync
MAIL_MAILER=log
FILESYSTEM_DISK=local

# Initial admin (used only by the seeder; change after first login)
KYAF_ADMIN_EMAIL=admin@kyaf.local
KYAF_ADMIN_PHONE=01700000001
KYAF_ADMIN_PASSWORD=
